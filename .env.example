APP_NAME="MinTour"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://mintour.test

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mintour
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_ENDPOINT=https://api.groq.com/openai/v1
GROQ_TIMEOUT=20
CHATBOT_RATE_LIMIT=20
CHATBOT_MAX_KB_RESULTS=5
CHATBOT_MAX_DB_RESULTS=6

Mintour_ADMIN_EMAIL=admin@mintour.local
Mintour_ADMIN_PASSWORD=admin123
